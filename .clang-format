Language: JavaScript
BasedOnStyle: Google

# Indentation
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 100

# Quote Style - Correct key for version 18
# Use 'Double' to force " or 'Leave' to keep whatever you typed
JavaScriptQuotes: Double

# Braces
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterControlStatement: Never
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: false
  BeforeElse: false
  IndentBraces: false

# Spacing - Crucial for Monkey C Dictionaries
SpaceBeforeAssignmentOperators: true
SpacesInContainerLiterals: true
SpaceBeforeJsonColon: true

# Alignment
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: false
AlignOperands: true

# Monkey C specific "Short" syntax handling
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false